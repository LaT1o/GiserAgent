# GiserAgent server 环境变量模板
# 复制为 .env 并填入真实值；.env 不纳入版本管理
# 模型提供商与 API Key 全部在界面「设置 → 模型提供商」中配置（密钥写入 server/.pi/auth.json）

# ---- 以下均可选，不填时使用 src/config.ts 中的默认值 ----

# HTTP 服务端口（默认 13001：高位段，避开常用低位端口；Electron 壳同段扫描 13001-13020）
# PORT=13001

# HTTP 监听地址（默认 0.0.0.0：局域网/端口映射设备可与桌面窗口访问同一前端；
# 仅本机使用可设 127.0.0.1——API 无鉴权，暴露到不可信网络注意风险）
# GISER_HOST=0.0.0.0

# 在 tsx 源码运行形态（npm run dev）临时托管 frontend/dist（默认不托管：
# 开发形态前端走 vite 5173，server 恒为纯 API；bundle 形态始终托管，不受此项影响）
# GISER_SERVE_DIST=1

# Agent 运行时实现（当前仅支持 pi）
# AGENT_ADAPTER=pi

# Python Runner 解释器路径（默认项目内便携 Python runtime/python/python.exe；
# 缺失时按 scripts/setup-python.md 重建，或在此指向本机已有解释器）
# GISER_PYTHON=D:/miniconda/envs/cglite/python.exe

# Agent 工具白名单，逗号分隔（默认全部内置 + 自定义：
# read,write,edit,ls,grep,find,bash,powershell,python,todo；
# grep/find 为只读搜索工具，powershell 仅 Windows；python 为 Python Runner
# 工具，todo 为任务清单工具，移除后 Agent 将无法使用）
# AGENT_TOOLS=read,write,edit,ls,grep,find,bash,powershell,python,todo

# Plan 模式允许的工具子集，逗号分隔（默认 read,ls,grep,find,bash,todo；
# write/edit/python/powershell 在 Plan 模式下被移除，bash 另受只读命令白名单限制）
# GISER_PLAN_TOOLS=read,ls,grep,find,bash,todo

# 执行前需要人工确认的工具，逗号分隔（默认 bash,powershell,python；
# 确认请求经 SSE 推到前端，批准/拒绝后 Agent 才继续）
# GISER_APPROVAL_TOOLS=bash,powershell,python

# 审批请求超时毫秒数，超时视为拒绝（默认 300000 即 5 分钟）
# GISER_APPROVAL_TIMEOUT_MS=300000
